# --- Flight data ------------------------------------------------------------
# The app uses the free community ADS-B aggregator at api.adsb.lol as its
# upstream source. No API key is required.

# --- Development helpers ----------------------------------------------------
# Force the /api/flights endpoint to return canned mock data instead of
# calling adsb.lol. Useful for offline development.
# USE_MOCK_FLIGHT_DATA=true

# Optional API key for api-ninjas airport lookup (improves /api/airport).
# API_NINJAS_KEY=
