# --- Flight data provider ---------------------------------------------------
# Which upstream flight-data source to use. One of:
#   adsblol  - api.adsb.lol (free, no key required)        [default]
#   opensky  - opensky-network.org (free, optional creds)
#   fr24     - Flightradar24 commercial API (requires key)
#
# If unset, the app picks `fr24` when FLIGHTRADAR24_API_KEY is configured,
# otherwise `adsblol` so it works out of the box for free.
FLIGHT_DATA_PROVIDER=adsblol

# Required only when FLIGHT_DATA_PROVIDER=fr24
# FLIGHTRADAR24_API_KEY=

# Optional Basic-auth credentials for OpenSky (raises rate limits).
# OPENSKY_USERNAME=
# OPENSKY_PASSWORD=

# Optional API key for api-ninjas airport lookup (improves /api/airport).
# API_NINJAS_KEY=

# --- Development helpers ----------------------------------------------------
# Force the /api/flights endpoint to return canned mock data instead of
# calling any upstream provider. Useful for offline development.
# USE_MOCK_FLIGHT_DATA=true
